<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EveryStore.AppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,0,24,32" Spacing="20" MaxWidth="1000" HorizontalAlignment="Left">

            <Button Style="{StaticResource GhostButton}" Click="Back_Click" HorizontalAlignment="Left" Padding="8,0" Margin="-8,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="Back" FontSize="13" />
                </StackPanel>
            </Button>

            <!-- Header -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="96" Height="96" CornerRadius="20" Background="{ThemeResource TileBrush}" VerticalAlignment="Top">
                    <Image x:Name="Icon" Stretch="Uniform" Margin="10" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock x:Name="NameText" FontSize="28" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <HyperlinkButton x:Name="DeveloperLink" Padding="0" FontSize="12" />
                        <TextBlock x:Name="CategoryText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TaglineText" TextWrapping="Wrap" FontSize="13" />

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <Button x:Name="PrimaryBtn" Style="{StaticResource PrimaryButton}" MinWidth="130" Height="38" Click="Primary_Click" />
                        <Button x:Name="DownloadBtn" Style="{StaticResource SecondaryButton}" Height="38" Click="DownloadOnly_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                <TextBlock Text="Download only" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelBtn" Style="{StaticResource SecondaryButton}" Height="38" Content="Cancel" Click="Cancel_Click" />
                        <Button x:Name="UninstallBtn" Style="{StaticResource GhostButton}" Height="38" Content="Uninstall" Click="Uninstall_Click" />
                    </StackPanel>

                    <ProgressBar x:Name="Progress" Maximum="100" Margin="0,4,0,0" MaxWidth="460" HorizontalAlignment="Left" Width="460" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="12" />
                </StackPanel>
            </Grid>

            <!-- Stats -->
            <Grid x:Name="Stats" ColumnSpacing="10" />

            <!-- Tabs -->
            <StackPanel Orientation="Horizontal" Spacing="8" x:Name="TabBar" />

            <StackPanel x:Name="OverviewPanel" Spacing="16" />
            <StackPanel x:Name="WhatsNewPanel" Spacing="10" Visibility="Collapsed" />
            <StackPanel x:Name="VersionsPanel" Spacing="10" Visibility="Collapsed" />
            <StackPanel x:Name="FeedbackPanel" Spacing="12" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Style="{StaticResource PrimaryButton}" Click="ReportBug_Click" Height="34">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEBE8;" FontSize="13" />
                            <TextBlock Text="Report a bug" Foreground="White" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Click="SendFeedback_Click" Height="34">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F2;" FontSize="13" />
                            <TextBlock Text="Send feedback" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="RatingText" FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="8" x:Name="IssueFilters" />
                <StackPanel x:Name="IssueList" Spacing="8" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
