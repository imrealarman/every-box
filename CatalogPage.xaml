<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EveryStore.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EveryStore">

    <Grid Padding="24,4,24,0" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}" FontSize="26" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search apps" VerticalAlignment="Center"
                     TextChanged="SearchBox_TextChanged" />
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Refresh" Click="Refresh_Click" VerticalAlignment="Center" />
        </Grid>

        <!-- Library: updates banner -->
        <Border x:Name="UpdatesBar" Grid.Row="1" Visibility="Collapsed" CornerRadius="8" Padding="16,10"
                Background="{ThemeResource AccentTintBrush}">
            <Grid>
                <TextBlock x:Name="UpdatesText" VerticalAlignment="Center" FontSize="13" />
                <Button Style="{StaticResource PrimaryButton}" Content="Update all" HorizontalAlignment="Right" Click="UpdateAll_Click" />
            </Grid>
        </Border>

        <GridView x:Name="Cards" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Cards_ItemClick"
                  Padding="0,0,0,24">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:AppEntry">
                    <Border Width="340" Padding="16" CornerRadius="8" Background="{ThemeResource PanelBrush}"
                            BorderBrush="{ThemeResource BorderBrush1}" BorderThickness="1">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="12" Background="{ThemeResource TileBrush}">
                                    <Image Source="{x:Bind IconSource, Mode=OneWay}" Stretch="Uniform" Margin="6" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Tagline, Mode=OneWay}" Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <ProgressBar Grid.Row="1" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind ProgressIndeterminate, Mode=OneWay}"
                                         Value="{x:Bind ProgressValue, Mode=OneWay}" Maximum="100" />

                            <Grid Grid.Row="2" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind StatusLine, Mode=OneWay}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{x:Bind ActionLabel, Mode=OneWay}"
                                        IsEnabled="{x:Bind CanAct, Mode=OneWay}" MinWidth="88" Click="Action_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource MutedText}" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
