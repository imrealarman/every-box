<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EveryStore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Every Store">

    <Grid x:Name="Root" Background="{ThemeResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Rail -->
        <Grid Background="{ThemeResource RailBrush}" Padding="12,44,12,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,0,22">
                <Image x:Name="BrandIcon" Width="28" Height="28" />
                <TextBlock Text="Every Store" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="4">
                <Button x:Name="NavDiscover" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="12,0" Height="38" Click="NavDiscover_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE71D;" FontSize="14" />
                        <TextBlock Text="Discover" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavLibrary" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="12,0" Height="38" Click="NavLibrary_Click">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                        <TextBlock Grid.Column="1" Text="Library" FontSize="13" />
                        <Border x:Name="UpdateBadge" Grid.Column="2" Visibility="Collapsed" Background="{StaticResource AccentBrush}"
                                CornerRadius="9" MinWidth="18" Height="18" Padding="5,0">
                            <TextBlock x:Name="UpdateBadgeText" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>
                <Button x:Name="NavSettings" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="12,0" Height="38" Click="NavSettings_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <TextBlock Text="Settings" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="RefreshedText" Grid.Row="3" Style="{StaticResource MutedText}" Margin="6,0,0,0" TextWrapping="Wrap" />
        </Grid>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Drag area for the borderless title bar -->
            <Border x:Name="TitleDrag" Height="36" Background="Transparent" />
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <InfoBar x:Name="Notice" IsOpen="False" Severity="Warning" Margin="24,0,24,8" />
                    <InfoBar x:Name="UpdateBar" IsOpen="False" Severity="Informational" Margin="24,0,24,8">
                        <InfoBar.ActionButton>
                            <Button Content="Open Library" Click="UpdateBar_Open" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
                <ContentControl x:Name="Host" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</Window>
